{
  "manifest_version": 3,
  "name": "비밀번호 금고 자동완성",
  "version": "1.0.0",
  "description": "맥에 설치한 '비밀번호 금고' 앱에 저장한 로그인을 이 브라우저에서 채워 넣습니다.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["nativeMessaging", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "비밀번호 금고" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
